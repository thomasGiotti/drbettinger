---
import SectionTitle from "./SectionTitle.astro";
import CtaButton from "./CtaButton.astro";
import Icon from "./Icon.astro";
import { site } from "../data/site.js";
---

<section id="votre-cabinet" class="grid grid-cols-1 lg:grid-cols-2">
  <div
    class="flex flex-col justify-center bg-accent px-6 py-20 sm:px-12 lg:px-16"
  >
    <SectionTitle title="Votre cabinet" class="mb-10" />

    <div class="max-w-md space-y-7 text-ink">
      <div class="flex gap-4">
        <Icon name="pin" class="mt-1 h-5 w-5 shrink-0 text-navy" />
        <div>
          <p class="text-xs tracking-wide-label uppercase text-ink-soft">
            Adresse
          </p>
          <p class="mt-1 leading-relaxed">
            {site.addressLine1}<br />{site.addressLine2}
          </p>
        </div>
      </div>

      <div class="flex gap-4">
        <Icon name="clock" class="mt-1 h-5 w-5 shrink-0 text-navy" />
        <div>
          <p class="text-xs tracking-wide-label uppercase text-ink-soft">
            Horaires
          </p>
          <dl class="mt-1 space-y-0.5">
            {
              site.hours.map((h) => (
                <div class="flex gap-2 text-sm">
                  <dt class="text-ink-soft">{h.day} :</dt>
                  <dd>{h.hours}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>

      <div class="flex gap-4">
        <Icon name="phone" class="mt-1 h-5 w-5 shrink-0 text-navy" />
        <div>
          <p class="text-xs tracking-wide-label uppercase text-ink-soft">
            Téléphone
          </p>
          <p class="mt-1">
            <a href={`tel:${site.phoneHref}`} class="hover:underline"
              >{site.phone}</a
            >
          </p>
        </div>
      </div>
    </div>

    <div class="mt-10">
      <CtaButton href="/contact/" variant="navy">Contactez le cabinet</CtaButton
      >
    </div>
  </div>

  <!-- Carte : localisation du cabinet. Filtre grayscale pour rester dans la palette du site. -->
  <div
    class="relative min-h-[420px] w-full overflow-hidden bg-navy-deep lg:min-h-full"
  >
    <iframe
      src="https://www.google.com/maps?q=11+Place+Jeanne+Mance,+52200+Langres&output=embed"
      class="absolute inset-0 h-full w-full [filter:grayscale(0.6)_contrast(0.9)_brightness(0.9)]"
      style="border:0;"
      allowfullscreen=""
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      title="Localisation du cabinet - 11 Place Jeanne Mance, 52200 Langres"
    ></iframe>
  </div>
</section>
