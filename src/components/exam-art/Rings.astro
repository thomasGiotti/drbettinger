---
// Cercles concentriques pointillés (onde de pouls), mêmes pas et opacités
// que l'illustration du hero : r = base + i * pas, opacité 0,34 - i * 0,05.
import { palette } from "./art.js";

interface Props {
  cx: number;
  cy: number;
  count?: number;
  base?: number;
  step?: number;
  opacity?: number;
  dash?: string;
}
const { cx, cy, count = 6, base = 46, step = 62, opacity = 0.34, dash = "2 9" } = Astro.props;
---

{
  Array.from({ length: count }).map((_, i) => (
    <circle
      class="ea-ring"
      cx={cx}
      cy={cy}
      r={base + i * step}
      stroke={palette.accent}
      stroke-opacity={Math.max(opacity - i * 0.05, 0.04).toFixed(2)}
      fill="none"
      stroke-dasharray={dash}
    />
  ))
}
