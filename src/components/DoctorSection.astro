---
import SectionTitle from "./SectionTitle.astro";
import VascularArt from "./VascularArt.astro";
import { site } from "../data/site.js";
---

<section id="votre-medecin" class="bg-white py-24">
  <div class="mx-auto max-w-7xl px-6 lg:px-10">
    <SectionTitle eyebrow="Votre praticien" title="Votre médecin" class="mb-14" />

    <div class="grid grid-cols-1 items-start gap-14 lg:grid-cols-[320px_1fr]">
      <div class="mx-auto lg:mx-0">
        <!-- Remplacer par : portrait réel du praticien, noir et blanc -->
        <VascularArt variant="portrait" class="h-72 w-72 rounded-full shadow-xl" />
      </div>

      <div class="max-w-2xl">
        <p class="text-lg leading-relaxed text-ink">
          {site.doctorName} est médecin <strong>angiologue</strong>, spécialiste du diagnostic et du
          traitement des pathologies veineuses, artérielles et lymphatiques. Installé{" "}
          {site.city !== "[Ville]" ? `à ${site.city}` : "[à préciser]"}, {site.doctorName} propose une prise en
          charge attentive, fondée sur un examen clinique approfondi et, lorsque nécessaire, un
          écho-doppler réalisé directement au cabinet.
        </p>
        <p class="mt-5 leading-relaxed text-ink-soft">
          Chaque consultation est l'occasion d'expliquer clairement le diagnostic posé et les options
          de traitement envisageables, avec pour objectif constant de rassurer et d'accompagner
          durablement les patients dans la gestion de leur santé vasculaire.
        </p>

        <div class="mt-10">
          <p class="mb-4 text-xs tracking-wide-label uppercase text-ink-soft">Formation &amp; diplômes</p>
          <ul class="space-y-2.5">
            {site.diplomas.map((d) => (
              <li class="flex gap-3 text-sm leading-relaxed text-ink">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent-dark"></span>
                <span>{d}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>

  <div class="mx-auto mt-20 max-w-4xl px-6">
    <div class="divider-dot"></div>
  </div>
</section>
