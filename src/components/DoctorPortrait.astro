---
// Portrait du praticien, prêt à recevoir la photo fournie par le Dr Bettinger.
// Il suffit de déposer le fichier à l'un de ces emplacements puis de
// reconstruire le site :
//   1. src/assets/images/dr-bettinger.jpg (recommandé) : Astro le convertit
//      en AVIF/WebP aux bonnes dimensions ;
//   2. public/images/dr-bettinger.jpg : servi tel quel (pensez à le réduire à
//      ~600 × 600 px avant de le déposer).
// Sans photo, on affiche un médaillon neutre aux couleurs du site (aucune
// photo inventée). Voir TODO-DR.md.
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import { existsSync } from "node:fs";
import { join } from "node:path";
import { site } from "../data/site.js";

interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;

const alt = site.doctorName;

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/dr-bettinger.{jpg,jpeg}",
  { eager: true },
);
const photo = Object.values(images)[0]?.default;
// Vérifié au moment du build (site statique) : process.cwd() est la racine du projet.
const publicPhoto = existsSync(join(process.cwd(), "public/images/dr-bettinger.jpg"))
  ? "/images/dr-bettinger.jpg"
  : null;
---

{
  photo ? (
    <Picture
      src={photo}
      formats={["avif", "webp"]}
      widths={[288, 576]}
      sizes="288px"
      width={288}
      height={288}
      alt={alt}
      class={`object-cover ${className}`}
    />
  ) : publicPhoto ? (
    <img
      src={publicPhoto}
      width="288"
      height="288"
      alt={alt}
      loading="lazy"
      decoding="async"
      class={`object-cover ${className}`}
    />
  ) : (
    <div
      class={`relative flex items-center justify-center overflow-hidden bg-navy ${className}`}
      aria-hidden="true"
    >
      {/* Mêmes cercles pointillés que PulsePattern, sans le point central. */}
      <svg class="absolute inset-0 h-full w-full" viewBox="0 0 288 288" fill="none">
        {[62, 92, 122].map((r, i) => (
          <circle cx="144" cy="144" r={r} stroke="#F0D8BC" stroke-opacity={0.45 - i * 0.12} stroke-dasharray="2 7" />
        ))}
      </svg>
      <span class="relative font-serif text-4xl tracking-label text-accent">
        {site.doctorFirstName[0]}{site.doctorLastName[0]}
      </span>
    </div>
  )
}
