---
// Portrait du praticien. Si `src/assets/images/dr-bettinger.jpg` existe, il
// est servi en AVIF/WebP (avec width/height) ; sinon on garde l'illustration
// neutre. Le fichier est placé dans src/ et non dans public/ : Astro ne peut
// convertir et redimensionner que les images importées depuis src/.
// TODO : ajouter la photo fournie par le Dr Bettinger (format carré conseillé).
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import VascularArt from "./VascularArt.astro";

interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/dr-bettinger.{jpg,jpeg}",
  { eager: true },
);
const photo = Object.values(images)[0]?.default;
---

{
  photo ? (
    <Picture
      src={photo}
      formats={["avif", "webp"]}
      widths={[288, 576]}
      sizes="288px"
      width={288}
      height={288}
      alt="Portrait du Dr Stéphane Bettinger"
      class={`object-cover ${className}`}
    />
  ) : (
    <VascularArt variant="portrait" class={className} />
  )
}
