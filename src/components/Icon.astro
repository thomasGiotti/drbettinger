---
// Icônes fines, dessinées en interne (aucun asset externe / aucune icône réutilisée).
interface Props {
  name:
    | "vein"
    | "doppler"
    | "syringe"
    | "laser"
    | "clot"
    | "artery"
    | "ulcer"
    | "compression"
    | "shield"
    | "pin"
    | "phone"
    | "mail"
    | "calendar"
    | "clock"
    | "chevron-down"
    | "menu"
    | "close";
  class?: string;
}
const { name, class: className = "w-6 h-6" } = Astro.props;
---

{name === "vein" && (
  <svg viewBox="0 0 48 48" fill="none" class={className} stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
    <path d="M10 40c4-6 2-10 6-14s10-2 12-8 -1-9 4-14" />
    <circle cx="10" cy="40" r="2" fill="currentColor" stroke="none" />
    <circle cx="32" cy="4" r="2" fill="currentColor" stroke="none" />
    <path d="M18 26c-3 1-6 0-8-2" />
    <path d="M28 16c3 0 5-1 7-3" />
  </svg>
)}

{name === "doppler" && (
  <svg viewBox="0 0 48 48" fill="none" class={className} stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M6 26h6l3-10 4 18 4-14 3 6h16" />
    <circle cx="24" cy="26" r="20" stroke-dasharray="1 4" />
  </svg>
)}

{name === "syringe" && (
  <svg viewBox="0 0 48 48" fill="none" class={className} stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M32 8l8 8-4 4-8-8z" />
    <path d="M36 12l-20 20" />
    <path d="M16 32l-8 8" />
    <path d="M12 28l8 8" />
    <path d="M8 40l4-4" />
  </svg>
)}

{name === "laser" && (
  <svg viewBox="0 0 48 48" fill="none" class={className} stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <rect x="6" y="20" width="14" height="8" rx="2" />
    <path d="M20 24h20" stroke-dasharray="2 3" />
    <path d="M40 24l-4-4M40 24l-4 4" />
  </svg>
)}

{name === "clot" && (
  <svg viewBox="0 0 48 48" fill="none" class={className} stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
    <path d="M8 24c0-9 7-16 16-16s16 7 16 16-7 16-16 16-16-7-16-16z" />
    <circle cx="22" cy="22" r="4" fill="currentColor" stroke="none" />
    <circle cx="28" cy="27" r="2.5" fill="currentColor" stroke="none" />
  </svg>
)}

{name === "artery" && (
  <svg viewBox="0 0 48 48" fill="none" class={className} stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
    <path d="M4 24h8l3-8 5 16 4-20 4 12h4" />
    <path d="M32 24h12" />
    <path d="M30 18c4-2 6-2 10 0" opacity="0.5" />
  </svg>
)}

{name === "ulcer" && (
  <svg viewBox="0 0 48 48" fill="none" class={className} stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
    <path d="M12 10c8 0 6 8 14 8s6-8 14-8" />
    <path d="M12 10v20c0 6 4 10 12 10s12-4 12-10V10" />
    <circle cx="24" cy="28" r="3" />
  </svg>
)}

{name === "compression" && (
  <svg viewBox="0 0 48 48" fill="none" class={className} stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
    <path d="M18 4h12l2 30-4 10h-8l-4-10z" />
    <path d="M18 12h12" opacity="0.6" />
    <path d="M18.6 20h10.8" opacity="0.6" />
    <path d="M19.3 28h9.4" opacity="0.6" />
  </svg>
)}

{name === "shield" && (
  <svg viewBox="0 0 24 24" fill="none" class={className} stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z" />
    <path d="M9 12l2 2 4-4.5" />
  </svg>
)}

{name === "pin" && (
  <svg viewBox="0 0 24 24" fill="none" class={className} stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M12 21s7-7.5 7-12a7 7 0 10-14 0c0 4.5 7 12 7 12z" />
    <circle cx="12" cy="9" r="2.3" />
  </svg>
)}

{name === "phone" && (
  <svg viewBox="0 0 24 24" fill="none" class={className} stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M6 3h3l2 5-2.5 2a11 11 0 005.5 5.5l2-2.5 5 2v3a2 2 0 01-2.2 2A17 17 0 014 5.2 2 2 0 016 3z" />
  </svg>
)}

{name === "mail" && (
  <svg viewBox="0 0 24 24" fill="none" class={className} stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <rect x="3" y="5" width="18" height="14" rx="2" />
    <path d="M3 7l9 6 9-6" />
  </svg>
)}

{name === "calendar" && (
  <svg viewBox="0 0 24 24" fill="none" class={className} stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <rect x="3" y="5" width="18" height="16" rx="2" />
    <path d="M3 10h18" />
    <path d="M8 3v4M16 3v4" />
  </svg>
)}

{name === "clock" && (
  <svg viewBox="0 0 24 24" fill="none" class={className} stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="9" />
    <path d="M12 7v5l3.5 2" />
  </svg>
)}

{name === "chevron-down" && (
  <svg viewBox="0 0 24 24" fill="none" class={className} stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M6 9l6 6 6-6" />
  </svg>
)}

{name === "menu" && (
  <svg viewBox="0 0 24 24" fill="none" class={className} stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
    <path d="M4 7h16M4 12h16M4 17h16" />
  </svg>
)}

{name === "close" && (
  <svg viewBox="0 0 24 24" fill="none" class={className} stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
    <path d="M6 6l12 12M18 6L6 18" />
  </svg>
)}
