---
interface Props {
  href: string;
  variant?: "accent" | "navy" | "outline-white";
  class?: string;
  external?: boolean;
  /** Nom accessible, quand le texte visible seul ne suffit pas (ex. un numéro). */
  label?: string;
}
const { href, variant = "accent", class: className = "", external = false, label } = Astro.props;

const variants = {
  accent: "bg-accent text-ink hover:bg-accent-dark",
  navy: "bg-navy text-white hover:bg-navy-deep",
  "outline-white": "border border-white/70 text-white hover:bg-white/10",
};
---

<a
  href={href}
  class={`inline-flex items-center justify-center gap-2 whitespace-nowrap px-7 py-3.5 text-xs tracking-wide-label uppercase font-medium transition-colors duration-200 ${variants[variant]} ${className}`}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  aria-label={label}
>
  <slot />
</a>
