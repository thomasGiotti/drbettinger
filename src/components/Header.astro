---
import Logo from "./Logo.astro";
import CtaButton from "./CtaButton.astro";
import Icon from "./Icon.astro";
import { site } from "../data/site.js";
import { pathologies } from "../data/pathologies.js";

const currentPath = Astro.url.pathname;
function isActive(href) {
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
}
---

<header
  id="site-header"
  class="absolute inset-x-0 top-0 z-50 transition-colors duration-300"
  data-scrolled="false"
>
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-6 py-5 lg:px-10">
    <Logo variant="light" class="shrink-0" />

    <nav class="hidden items-center gap-6 xl:flex" aria-label="Navigation principale">
      <a href="/" class:list={["nav-link", { "nav-link--active": isActive("/") }]}>Accueil</a>
      <a href="/le-medecin/" class:list={["nav-link", { "nav-link--active": isActive("/le-medecin/") }]}>Le médecin</a>

      <div class="group relative">
        <button class="nav-link inline-flex items-center gap-1.5" aria-haspopup="true">
          Pathologies &amp; actes
          <Icon name="chevron-down" class="h-3.5 w-3.5" />
        </button>
        <div
          class="invisible absolute left-1/2 top-full w-72 -translate-x-1/2 pt-4 opacity-0 transition-all duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100"
        >
          <ul class="rounded-sm bg-white p-2 text-left shadow-xl ring-1 ring-black/5">
            <li>
              <a href="/pathologies/" class="block rounded-sm px-4 py-2.5 font-serif text-sm text-navy hover:bg-accent/40">
                Toutes les pathologies &amp; actes
              </a>
            </li>
            <li class="my-1 border-t border-ink-soft/10"></li>
            {pathologies.map((p) => (
              <li>
                <a
                  href={`/pathologies/${p.slug}/`}
                  class="block px-4 py-2 text-sm text-ink hover:bg-accent/30 hover:text-navy"
                >
                  {p.navTitle}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <a href="/tarifs/" class:list={["nav-link", { "nav-link--active": isActive("/tarifs/") }]}>Tarifs</a>
      <a href="/actualites/" class:list={["nav-link", { "nav-link--active": isActive("/actualites/") }]}>Actualités</a>
      <a href="/contact/" class:list={["nav-link", { "nav-link--active": isActive("/contact/") }]}>Contact</a>
    </nav>

    <div class="hidden xl:block">
      <CtaButton href={site.bookingUrl} variant="accent">
        {site.bookingLabelShort}
      </CtaButton>
    </div>

    <button
      id="mobile-menu-toggle"
      class="inline-flex h-10 w-10 items-center justify-center text-white xl:hidden"
      aria-label="Ouvrir le menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <Icon name="menu" class="h-6 w-6" />
    </button>
  </div>

  <div id="mobile-menu" class="hidden xl:hidden">
    <div class="space-y-1 bg-navy-deep px-6 pb-6 pt-2">
      <a href="/" class="block py-2.5 text-sm tracking-label uppercase text-white/90">Accueil</a>
      <a href="/le-medecin/" class="block py-2.5 text-sm tracking-label uppercase text-white/90">Le médecin</a>
      <a href="/pathologies/" class="block py-2.5 text-sm tracking-label uppercase text-white/90">Pathologies &amp; actes</a>
      <a href="/tarifs/" class="block py-2.5 text-sm tracking-label uppercase text-white/90">Tarifs</a>
      <a href="/actualites/" class="block py-2.5 text-sm tracking-label uppercase text-white/90">Actualités</a>
      <a href="/contact/" class="block py-2.5 text-sm tracking-label uppercase text-white/90">Contact</a>
      <a href={site.bookingUrl} class="mt-3 block bg-accent px-5 py-3 text-center text-xs tracking-wide-label uppercase text-ink">
        {site.bookingLabelShort}
      </a>
    </div>
  </div>
</header>

<style>
  .nav-link {
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
    color: rgba(255, 255, 255, 0.9);
    padding-bottom: 2px;
    border-bottom: 1px solid transparent;
  }
  .nav-link:hover,
  .nav-link--active {
    color: #fff;
    border-bottom-color: #f0d8bc;
  }
</style>

<script>
  const toggle = document.getElementById("mobile-menu-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    const isHidden = menu?.classList.contains("hidden");
    menu?.classList.toggle("hidden");
    toggle.setAttribute("aria-expanded", String(isHidden));
  });

  const header = document.getElementById("site-header");
  const onScroll = () => {
    if (!header) return;
    if (window.scrollY > 40) {
      header.classList.add("bg-navy-deep/95", "backdrop-blur-sm", "shadow-sm");
    } else {
      header.classList.remove("bg-navy-deep/95", "backdrop-blur-sm", "shadow-sm");
    }
  };
  document.addEventListener("scroll", onScroll, { passive: true });
  onScroll();
</script>
