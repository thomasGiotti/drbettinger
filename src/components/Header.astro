---
import Logo from "./Logo.astro";
import CtaButton from "./CtaButton.astro";
import Icon from "./Icon.astro";
import { site } from "../data/site.js";
import { pathologies } from "../data/pathologies.js";

const currentPath = Astro.url.pathname;
function isActive(href) {
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
}

// Seule la page d'accueil possède un hero plein écran : le header y démarre
// transparent puis passe en --navy plein au scroll. Partout ailleurs il est
// en --navy plein dès le départ, sans transition.
const overHero = currentPath === "/";
---

<header
  id="site-header"
  class="site-header sticky top-0 z-50"
  data-hero={overHero ? "true" : "false"}
  data-scrolled="false"
>
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-6 py-5 lg:px-10">
    <Logo variant="light" class="shrink-0" />

    <nav class="hidden items-center gap-6 xl:flex" aria-label="Navigation principale">
      <a href="/" class:list={["nav-link", { "nav-link--active": isActive("/") }]}>Accueil</a>
      <a href="/le-medecin/" class:list={["nav-link", { "nav-link--active": isActive("/le-medecin/") }]}>Le médecin</a>

      <div class="group relative" data-submenu-group>
        <button
          class="nav-link inline-flex items-center gap-1.5"
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="submenu-examens"
          data-submenu-toggle
        >
          Examens &amp; actes
          <Icon name="chevron-down" class="h-3.5 w-3.5" />
        </button>
        <div
          id="submenu-examens"
          class="invisible absolute left-1/2 top-full w-72 -translate-x-1/2 pt-4 opacity-0 transition-all duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100"
        >
          <ul class="rounded-sm bg-white p-2 text-left shadow-xl ring-1 ring-black/5">
            <li>
              <a href="/pathologies/" class="block rounded-sm px-4 py-2.5 font-serif text-sm text-navy hover:bg-accent/40">
                Tous les examens &amp; actes
              </a>
            </li>
            <li class="my-1 border-t border-ink-soft/10"></li>
            {pathologies.map((p) => (
              <li>
                <a
                  href={`/pathologies/${p.slug}/`}
                  class="block px-4 py-2 text-sm text-ink hover:bg-accent/30 hover:text-navy"
                >
                  {p.navTitle}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <a href="/tarifs/" class:list={["nav-link", { "nav-link--active": isActive("/tarifs/") }]}>Tarifs</a>
      <a href="/actualites/" class:list={["nav-link", { "nav-link--active": isActive("/actualites/") }]}>Actualités</a>
      <a href="/contact/" class:list={["nav-link", { "nav-link--active": isActive("/contact/") }]}>Contact</a>
    </nav>

    <!-- Sur ordinateur, un lien tel: seul ne sert à rien : on affiche le numéro. -->
    <div class="hidden xl:block">
      <CtaButton
        href={site.bookingUrl}
        variant="accent"
        label={`${site.bookingLabel} par téléphone au ${site.phone}`}
      >
        <Icon name="phone" class="h-3.5 w-3.5" />
        {site.phone}
      </CtaButton>
    </div>

    <button
      id="mobile-menu-toggle"
      class="inline-flex h-10 w-10 items-center justify-center text-white xl:hidden"
      aria-label="Ouvrir le menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <Icon name="menu" class="h-6 w-6" />
    </button>
  </div>

  <div id="mobile-menu" class="hidden xl:hidden">
    <div class="space-y-1 bg-navy-deep px-6 pb-6 pt-2">
      <a href="/" class="block py-2.5 text-sm tracking-label uppercase text-white/90">Accueil</a>
      <a href="/le-medecin/" class="block py-2.5 text-sm tracking-label uppercase text-white/90">Le médecin</a>
      <a href="/pathologies/" class="block py-2.5 text-sm tracking-label uppercase text-white/90">Examens &amp; actes</a>
      <a href="/tarifs/" class="block py-2.5 text-sm tracking-label uppercase text-white/90">Tarifs</a>
      <a href="/actualites/" class="block py-2.5 text-sm tracking-label uppercase text-white/90">Actualités</a>
      <a href="/contact/" class="block py-2.5 text-sm tracking-label uppercase text-white/90">Contact</a>
      <a href={site.bookingUrl} class="mt-3 block bg-accent px-5 py-3 text-center text-xs tracking-wide-label uppercase text-ink">
        {site.bookingLabelShort}
      </a>
    </div>
  </div>
</header>

<style>
  /* Le header est sticky et ne consomme pas de hauteur dans le flux : la marge
     négative laisse le contenu (hero) remonter dessous, comme avec l'ancien
     positionnement absolu. */
  .site-header {
    margin-bottom: -5rem;
    background-color: var(--color-navy);
  }

  /* Page d'accueil : transparent au départ, --navy plein une fois scrollé. */
  .site-header[data-hero="true"] {
    background-color: transparent;
    transition: background-color 200ms ease, box-shadow 200ms ease;
  }
  .site-header[data-hero="true"][data-scrolled="true"] {
    background-color: var(--color-navy);
    box-shadow: 0 10px 30px -18px rgba(0, 0, 0, 0.55);
  }

  /* Échap force la fermeture du sous-menu, même si le focus ou la souris y
     reste (le CSS l'ouvre sinon au survol / focus). Styles non « layered » :
     ils l'emportent sur les utilitaires Tailwind group-hover/focus-within. */
  [data-submenu-group][data-closed] #submenu-examens {
    visibility: hidden;
    opacity: 0;
  }

  .nav-link {
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
    color: rgba(255, 255, 255, 0.9);
    padding-bottom: 2px;
    border-bottom: 1px solid transparent;
  }
  .nav-link:hover,
  .nav-link--active {
    color: #fff;
    border-bottom-color: #f0d8bc;
  }
</style>

<script>
  // Nettoyage : l'ancien bandeau cookies (supprimé) mémorisait le choix du
  // visiteur sous cette clé. Le site ne stocke plus rien côté navigateur.
  try {
    localStorage.removeItem("cookie-consent");
  } catch {
    // Stockage indisponible (navigation privée, blocage) : rien à nettoyer.
  }

  const toggle = document.getElementById("mobile-menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const setMenuOpen = (open: boolean) => {
    menu?.classList.toggle("hidden", !open);
    toggle?.setAttribute("aria-expanded", String(open));
    toggle?.setAttribute("aria-label", open ? "Fermer le menu" : "Ouvrir le menu");
  };
  toggle?.addEventListener("click", () => {
    setMenuOpen(menu?.classList.contains("hidden") ?? false);
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && menu && !menu.classList.contains("hidden")) {
      setMenuOpen(false);
      toggle?.focus();
    }
  });

  // Sous-menu « Examens & actes » : ouvert en CSS au survol et au focus
  // (group-hover / group-focus-within). On reflète cet état dans
  // aria-expanded ; Échap le referme (data-closed) et rend le focus au
  // bouton, jusqu'à ce que le focus et la souris aient quitté le groupe.
  const submenuGroup = document.querySelector<HTMLElement>("[data-submenu-group]");
  const submenuToggle = submenuGroup?.querySelector<HTMLButtonElement>("[data-submenu-toggle]");
  if (submenuGroup && submenuToggle) {
    const sync = () => {
      const active = submenuGroup.matches(":hover, :focus-within");
      if (!active) delete submenuGroup.dataset.closed;
      const open = active && submenuGroup.dataset.closed === undefined;
      submenuToggle.setAttribute("aria-expanded", String(open));
    };
    for (const type of ["mouseenter", "mouseleave", "focusin", "focusout"]) {
      // setTimeout plutôt que requestAnimationFrame : focusout survient avant
      // que le focus ait quitté le groupe, et rAF est suspendu en arrière-plan.
      submenuGroup.addEventListener(type, () => setTimeout(sync, 0));
    }
    submenuGroup.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        submenuGroup.dataset.closed = "";
        submenuToggle.focus();
        sync();
      }
    });
  }

  // Bascule transparent -> --navy plein uniquement sur la page d'accueil
  // (hero plein écran). Ailleurs le header est déjà en --navy plein.
  const header = document.getElementById("site-header");
  if (header && header.dataset.hero === "true") {
    const onScroll = () => {
      header.dataset.scrolled = window.scrollY > 50 ? "true" : "false";
    };
    document.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }
</script>
