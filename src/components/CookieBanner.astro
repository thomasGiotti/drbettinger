<div
  id="cookie-banner"
  class="fixed inset-x-0 bottom-0 z-[60] hidden border-t border-ink/10 bg-white/98 px-6 py-4 shadow-[0_-4px_20px_rgba(0,0,0,0.08)] backdrop-blur"
  role="dialog"
  aria-label="Gestion des cookies"
>
  <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-4 sm:flex-row">
    <p class="text-sm text-ink-soft">
      Ce site utilise des cookies strictement nécessaires à son fonctionnement et, avec votre accord,
      des cookies de mesure d'audience anonymisée.
      <a href="/politique-confidentialite/" class="underline hover:text-ink">En savoir plus</a>.
    </p>
    <div class="flex shrink-0 items-center gap-3">
      <button
        id="cookie-refuse"
        class="px-5 py-2.5 text-xs tracking-wide-label uppercase text-ink-soft hover:text-ink"
      >
        Refuser
      </button>
      <button
        id="cookie-accept"
        class="bg-navy px-5 py-2.5 text-xs tracking-wide-label uppercase text-white hover:bg-navy-deep"
      >
        Accepter
      </button>
    </div>
  </div>
</div>

<script>
  const KEY = "cookie-consent";
  const banner = document.getElementById("cookie-banner");
  if (banner && !localStorage.getItem(KEY)) {
    banner.classList.remove("hidden");
  }
  document.getElementById("cookie-accept")?.addEventListener("click", () => {
    localStorage.setItem(KEY, "accepted");
    banner?.classList.add("hidden");
  });
  document.getElementById("cookie-refuse")?.addEventListener("click", () => {
    localStorage.setItem(KEY, "refused");
    banner?.classList.add("hidden");
  });
</script>
