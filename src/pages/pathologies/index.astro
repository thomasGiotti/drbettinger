---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import PathologyCard from "../../components/PathologyCard.astro";
import { pathologies } from "../../data/pathologies.js";
import { site } from "../../data/site.js";

const title = `Examens & actes - ${site.doctorName}, angiologue à ${site.city}`;
const description =
  "Écho-doppler transcrânien, des troncs supra-aortiques, des membres, aortique et viscéral, veineux, pénien ; dépistage d'anévrisme ; phlébites et thrombophilies : les examens vasculaires réalisés au cabinet.";
---

<BaseLayout title={title} description={description}>
  <PageHero
    eyebrow="Comprendre & se soigner"
    title="Examens & actes"
    subtitle="Un vocabulaire simple pour comprendre les examens réalisés au cabinet et les situations dans lesquelles ils sont proposés. Ces pages ont une vocation d'information générale : seule une consultation permet un avis individualisé."
  />

  <section class="bg-cream py-24">
    <div class="mx-auto max-w-7xl px-6 lg:px-10">
      <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {
          pathologies.map((p) => (
            <PathologyCard
              slug={p.slug}
              icon={p.icon}
              title={p.cardTitle}
              desc={p.cardDesc}
            />
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
