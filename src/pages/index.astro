---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import ReassuranceStrip from "../components/ReassuranceStrip.astro";
import DoctorSection from "../components/DoctorSection.astro";
import TreatmentsHome from "../components/TreatmentsHome.astro";
import CabinetSection from "../components/CabinetSection.astro";
import { site } from "../data/site.js";

const title = `Angiologue à ${site.city} - ${site.doctorName}`;
// Meta description (SEO Google) : ~130 caractères.
const description = `${site.doctorName}, angiologue à ${site.city}. Écho-doppler, diagnostic et suivi des pathologies veineuses et artérielles. Secteur 1.`;
// Description dédiée au partage social (og:description / twitter:description) : ~120 caractères, message distinct du SEO.
const socialDescription = `${site.doctorName}, médecin spécialiste en médecine vasculaire à ${site.city}. Secteur 1, sans dépassement d'honoraires.`;
---

<BaseLayout title={title} description={description} socialDescription={socialDescription} schema>
  <Hero />
  <ReassuranceStrip />
  <DoctorSection />
  <TreatmentsHome />
  <CabinetSection />
</BaseLayout>
