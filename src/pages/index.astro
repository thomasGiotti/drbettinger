---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import ReassuranceStrip from "../components/ReassuranceStrip.astro";
import DoctorSection from "../components/DoctorSection.astro";
import TreatmentsHome from "../components/TreatmentsHome.astro";
import CabinetSection from "../components/CabinetSection.astro";
import { site } from "../data/site.js";

const title = `Angiologue à ${site.city} - ${site.doctorName}`;
const description = `${site.doctorName}, médecin spécialiste en médecine vasculaire à ${site.city} : diagnostic et suivi des maladies veineuses, artérielles et lymphatiques. Écho-doppler réalisé au cabinet, dépistage d'anévrisme, phlébites et thrombophilies. Secteur 1.`;
---

<BaseLayout title={title} description={description}>
  <Hero />
  <ReassuranceStrip />
  <DoctorSection />
  <TreatmentsHome />
  <CabinetSection />
</BaseLayout>
