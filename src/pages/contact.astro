---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import SectionTitle from "../components/SectionTitle.astro";
import CtaButton from "../components/CtaButton.astro";
import Icon from "../components/Icon.astro";
import EmergencyNotice from "../components/EmergencyNotice.astro";
import MapEmbed from "../components/MapEmbed.astro";
import { site } from "../data/site.js";

const title = "Contact et horaires";
const description = `Coordonnées et horaires du cabinet de ${site.doctorName}, angiologue à ${site.city}. Rendez-vous uniquement par téléphone au ${site.phone}.`;
---

<BaseLayout title={title} description={description} schema>
  <PageHero eyebrow="Nous contacter" title="Contact" />

  <section class="bg-cream py-24">
    <div
      class="mx-auto grid max-w-7xl grid-cols-1 gap-16 px-6 lg:grid-cols-2 lg:px-10"
    >
      <div>
        <SectionTitle title="Prendre rendez-vous" class="mb-8" />
        <p class="leading-relaxed text-ink-soft">
          La prise de rendez-vous se fait uniquement par téléphone auprès du
          secrétariat, aux horaires d'ouverture du cabinet. Merci de ne
          transmettre aucune information de santé par téléphone au secrétariat.
        </p>

        <div class="mt-8 flex flex-wrap gap-4">
          <CtaButton href={`tel:${site.phoneHref}`} variant="accent"
            >{site.bookingLabelShort}</CtaButton
          >
        </div>

        <!-- Voir EmergencyNotice.astro : message à conserver impérativement. -->
        <EmergencyNotice class="mt-8" />

        <div class="mt-14 space-y-6">
          <div class="flex gap-4">
            <Icon name="phone" class="mt-1 h-5 w-5 shrink-0 text-navy" />
            <div>
              <p class="text-xs tracking-wide-label uppercase text-ink-soft">
                Téléphone
              </p>
              <p class="mt-1">
                <a
                  href={`tel:${site.phoneHref}`}
                  class="leading-relaxed text-ink hover:underline"
                  >{site.phone}</a
                >
              </p>
            </div>
          </div>
          <div class="flex gap-4">
            <Icon name="pin" class="mt-1 h-5 w-5 shrink-0 text-navy" />
            <div>
              <p class="text-xs tracking-wide-label uppercase text-ink-soft">
                Adresse
              </p>
              <p class="mt-1 leading-relaxed text-ink">
                {site.addressLine1}<br />{site.addressLine2}
              </p>
            </div>
          </div>
          <div class="flex gap-4">
            <Icon name="clock" class="mt-1 h-5 w-5 shrink-0 text-navy" />
            <div>
              <p class="text-xs tracking-wide-label uppercase text-ink-soft">
                Horaires
              </p>
              <dl class="mt-1 space-y-0.5">
                {
                  site.hours.map((h) => (
                    <div class="flex gap-2 text-sm text-ink">
                      <dt class="text-ink-soft">{h.day} :</dt>
                      <dd>{h.hours}</dd>
                    </div>
                  ))
                }
              </dl>
              <p class="mt-2 text-sm leading-relaxed text-ink-soft">
                {site.urgentSlotsNote}
              </p>
            </div>
          </div>
          {
            site.access && (
              <div class="flex gap-4">
                <Icon name="pin" class="mt-1 h-5 w-5 shrink-0 text-navy" />
                <div>
                  <p class="text-xs tracking-wide-label uppercase text-ink-soft">
                    Accès
                  </p>
                  <p class="mt-1 leading-relaxed text-ink">{site.access}</p>
                </div>
              </div>
            )
          }
        </div>
      </div>

      <div>
        <SectionTitle title="Localisation" class="mb-8" />
        <!-- Carte : localisation du cabinet, chargée uniquement au clic (voir MapEmbed.astro). -->
        <MapEmbed class="aspect-[4/3] border border-ink-soft/15" />
      </div>
    </div>
  </section>
</BaseLayout>
