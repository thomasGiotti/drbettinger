---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import SectionTitle from "../components/SectionTitle.astro";
import CtaButton from "../components/CtaButton.astro";
import Icon from "../components/Icon.astro";
import { site } from "../data/site.js";

const title = `Contact - ${site.doctorName}, angiologue à ${site.city}`;
const description = `Coordonnées, horaires et accès du cabinet de ${site.doctorName} à ${site.city}.`;
---

<BaseLayout title={title} description={description}>
  <PageHero eyebrow="Nous contacter" title="Contact" />

  <section class="bg-cream py-24">
    <div
      class="mx-auto grid max-w-7xl grid-cols-1 gap-16 px-6 lg:grid-cols-2 lg:px-10"
    >
      <div>
        <SectionTitle title="Prendre rendez-vous" class="mb-8" />
        <p class="leading-relaxed text-ink-soft">
          La prise de rendez-vous se fait uniquement par téléphone auprès du
          secrétariat, aux horaires d'ouverture du cabinet. Merci de ne
          transmettre aucune information de santé par téléphone au secrétariat.
        </p>

        <div class="mt-8 flex flex-wrap gap-4">
          <CtaButton href={`tel:${site.phoneHref}`} variant="accent"
            >{site.bookingLabelShort}</CtaButton
          >
        </div>

        <div class="mt-14 space-y-6">
          <div class="flex gap-4">
            <Icon name="phone" class="mt-1 h-5 w-5 shrink-0 text-navy" />
            <div>
              <p class="text-xs tracking-wide-label uppercase text-ink-soft">
                Téléphone
              </p>
              <p class="mt-1">
                <a
                  href={`tel:${site.phoneHref}`}
                  class="leading-relaxed text-ink hover:underline"
                  >{site.phone}</a
                >
              </p>
            </div>
          </div>
          <div class="flex gap-4">
            <Icon name="pin" class="mt-1 h-5 w-5 shrink-0 text-navy" />
            <div>
              <p class="text-xs tracking-wide-label uppercase text-ink-soft">
                Adresse
              </p>
              <p class="mt-1 leading-relaxed text-ink">
                {site.addressLine1}<br />{site.addressLine2}
              </p>
            </div>
          </div>
          <div class="flex gap-4">
            <Icon name="clock" class="mt-1 h-5 w-5 shrink-0 text-navy" />
            <div>
              <p class="text-xs tracking-wide-label uppercase text-ink-soft">
                Horaires
              </p>
              <dl class="mt-1 space-y-0.5">
                {
                  site.hours.map((h) => (
                    <div class="flex gap-2 text-sm text-ink">
                      <dt class="text-ink-soft">{h.day} :</dt>
                      <dd>{h.hours}</dd>
                    </div>
                  ))
                }
              </dl>
            </div>
          </div>
          <div class="flex gap-4">
            <Icon name="pin" class="mt-1 h-5 w-5 shrink-0 text-navy" />
            <div>
              <p class="text-xs tracking-wide-label uppercase text-ink-soft">
                Accès
              </p>
              <p class="mt-1 leading-relaxed text-ink">{site.access}</p>
            </div>
          </div>
        </div>
      </div>

      <div>
        <SectionTitle title="Localisation" class="mb-8" />
        <!-- Carte : localisation du cabinet. Filtre grayscale pour rester dans la palette du site. -->
        <div
          class="relative aspect-[4/3] w-full overflow-hidden border border-ink-soft/15 bg-navy-deep"
        >
          <iframe
            src="https://www.google.com/maps?q=11+Place+Jeanne+Mance,+52200+Langres&output=embed"
            class="absolute inset-0 h-full w-full [filter:grayscale(0.6)_contrast(0.9)_brightness(0.9)]"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Localisation du cabinet - 11 Place Jeanne Mance, 52200 Langres"
          ></iframe>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
