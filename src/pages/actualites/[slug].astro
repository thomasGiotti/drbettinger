---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import SectionTitle from "../../components/SectionTitle.astro";
import CtaButton from "../../components/CtaButton.astro";
import { articles } from "../../data/articles.js";
import { site } from "../../data/site.js";

export function getStaticPaths() {
  return articles.map((a) => ({
    params: { slug: a.slug },
    props: { article: a },
  }));
}

const { article } = Astro.props;
const dateFormatter = new Intl.DateTimeFormat("fr-FR", {
  day: "numeric",
  month: "long",
  year: "numeric",
});

// Rétrocompatibilité : les anciens articles fournissent `body` (tableau de
// paragraphes). Les nouveaux fournissent `content` (blocs typés : h2, p, ul, note).
const blocks = article.content ?? article.body.map((text) => ({ type: "p", text }));
const hasNote = blocks.some((b) => b.type === "note");

const title = `${article.title} - ${site.doctorName}`;
const description = article.excerpt;
---

<BaseLayout title={title} description={description}>
  <PageHero
    eyebrow={dateFormatter.format(new Date(article.date))}
    title={article.title}
    subtitle={article.author ? `Par ${article.author}` : undefined}
  />

  <section class="bg-cream py-20">
    <!-- Même gabarit que les pages d'examens/actes : fond --cream, titres serif
         avec bloc --accent (SectionTitle), colonne de texte confortable. -->
    <div class="mx-auto max-w-2xl px-6 lg:px-10">
      <div class="space-y-6 leading-relaxed text-ink">
        {
          blocks.map((block) => {
            if (block.type === "h2") {
              return (
                <SectionTitle
                  title={block.text}
                  class="!mt-14 first:!mt-0"
                />
              );
            }
            if (block.type === "ul") {
              return (
                <ul class="ml-5 list-disc space-y-2 text-ink-soft marker:text-accent-dark">
                  {block.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              );
            }
            if (block.type === "note") {
              return (
                <p class="border-l-2 border-accent pl-4 text-sm italic text-ink-soft">
                  {block.text}
                </p>
              );
            }
            return <p class="text-ink-soft">{block.text}</p>;
          })
        }
      </div>

      <div
        class="mt-14 flex flex-col items-center gap-6 border-t border-ink-soft/10 pt-14 text-center"
      >
        {
          !hasNote && (
            <p class="max-w-md text-ink-soft">
              Cet article est fourni à titre d'information générale et ne remplace
              pas un avis médical individualisé.
            </p>
          )
        }
        <CtaButton href={site.bookingUrl} variant="accent"
          >Prendre rendez-vous</CtaButton
        >
      </div>
    </div>
  </section>
</BaseLayout>
